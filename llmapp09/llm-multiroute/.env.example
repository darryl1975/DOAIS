# Ollama Cloud API
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_api_key_here
OLLAMA_TEMPERATURE=0.7

# Per-route model assignments (must be available on Ollama cloud)
OLLAMA_MODEL_CLASSIFY=gemma4:31b
OLLAMA_MODEL_SENTIMENT=glm-5.2
OLLAMA_MODEL_SUMMARIZE=mistral-large-3:675b
OLLAMA_MODEL_INTENT=minimax-m3

# Server
SERVER_PORT=8080

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OPENAI_API_KEY=sk-proj-xxxxxxx